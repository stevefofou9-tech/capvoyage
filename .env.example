# ========================================================
# CapVoyage - Variables d'Environnement de Production
# ========================================================

# Environnement et Port
NODE_ENV=production
PORT=3000

# Base de Données SQLite (Option B)
# Emplacement sur le volume persistant
DATABASE_PATH=/app/data/capvoyage.db

# Sécurité & CORS
# Remplacer par l'URL publique exacte de votre application en production
ALLOWED_ORIGIN=https://capvoyage.votre-domaine.com

# Service E-mail Transactionnel (Magic Codes d'accès)
# Option 1 : API Resend (Recommandé, simple et rapide)
RESEND_API_KEY=re_votre_cle_api_ici
EMAIL_FROM="CapVoyage <auth@votre-domaine.com>"

# Option 2 : SMTP Standard (Alternative)
# SMTP_HOST=smtp.votre-fournisseur.com
# SMTP_PORT=587
# SMTP_USER=votre-compte@domaine.com
# SMTP_PASS=votre-mot-de-passe-secret
